{
	"name": "obsidian-publictxt-remotes",
	"version": "1.0.0",
	"description": "Obsidian plugin: follow PublicTxt repos and fork their pages into your vault.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test \"tests/**/*.test.ts\"",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"license": "GPL-3.0-or-later",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^10.14.0",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.14.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.72.1"
	}
}
